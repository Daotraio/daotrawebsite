# Copy to .env.local for development. In the Cloudflare Workers environments set
# the same keys with `npx wrangler secret put NAME --env=<staging|production>`.
# Nothing in this file is a real secret.

# --- Daotra API (the Publisher identity backend — docs/DAOTRA_INTEGRATION.md) ---
# The api service's origin; https outside development.
DAOTRA_API_BASE_URL=http://127.0.0.1:8010
# Shared with the Daotra api service (DAOTRA_WEBSITE_GATEWAY_SECRET there),
# at least 32 random characters. Never commit a real value.
DAOTRA_WEBSITE_GATEWAY_SECRET=

# --- Rate limiting (Upstash Redis) ---
# If unset, the app falls back to an in-memory limiter per isolate — a best
# effort only. Daotra's own per-address limits are the authoritative ones.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection on public forms (Cloudflare Turnstile) — not wired yet ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Transactional email (contact form). Not wired yet. ---
EMAIL_FROM=no-reply@daotra.io
RESEND_API_KEY=
