# Copy to .env.local for development, and set the same keys in Vercel's
# Environment Variables for production. Nothing in this file is a real secret.

# --- Auth (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-32-byte-random-string

# --- Database (wire up your provider of choice for users/sessions) ---
DATABASE_URL=

# --- Rate limiting (Upstash Redis) ---
# If unset, the app falls back to an in-memory limiter that only works on a
# single instance - set these in production. Get values from upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection on public forms (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Transactional email (contact form + auth emails). Plug any provider. ---
EMAIL_FROM=no-reply@daotra.io
RESEND_API_KEY=
